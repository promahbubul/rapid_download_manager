{
  "manifest_version": 3,
  "name": "Rapid Download Manager Integration",
  "version": "1.0.0",
  "description": "Seamlessly intercepts downloads and sends them to Rapid Download Manager for multi-threaded speed.",
  "permissions": [
    "downloads",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rapid Download Manager"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
